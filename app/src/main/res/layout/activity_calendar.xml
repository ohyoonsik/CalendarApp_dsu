<?xml version="1.0" encoding="utf-8"?>
<!-- Calendar screen. Wire: rv_calendar = GridLayoutManager(7) with item_calendar_day,
     rv_agenda = LinearLayoutManager with item_event_agenda. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_screen"
            android:paddingTop="10dp"
            android:paddingBottom="@dimen/space_sm">

            <TextView android:id="@+id/tv_month" android:layout_width="wrap_content" android:layout_height="wrap_content"
                tools:text="6월" android:textColor="@color/ink" android:textSize="@dimen/text_display" android:textStyle="bold" />
            <TextView android:id="@+id/tv_year" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm" tools:text="2026" android:textColor="@color/ink_faint" android:textSize="15sp" />

            <ImageButton android:id="@+id/btn_theme" android:layout_width="40dp" android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:padding="9dp"
                android:src="@drawable/ic_moon" app:tint="@color/ink_soft" android:contentDescription="테마 전환" />

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <ImageButton android:id="@+id/btn_prev" android:layout_width="40dp" android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:padding="9dp"
                android:src="@drawable/ic_chevron_left" app:tint="@color/ink_soft" android:contentDescription="이전 달" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_today"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/today"
                android:textColor="@color/accent" android:textSize="@dimen/text_label" android:textStyle="bold" />
            <ImageButton android:id="@+id/btn_next" android:layout_width="40dp" android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:padding="9dp"
                android:src="@drawable/ic_chevron_right" app:tint="@color/ink_soft" android:contentDescription="다음 달" />

            <ImageButton android:id="@+id/btn_add" android:layout_width="40dp" android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:padding="9dp"
                android:src="@drawable/ic_plus" app:tint="@color/accent" android:contentDescription="새 일정" />
        </LinearLayout>

        <!-- Weekday row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="일" android:textColor="@color/weekend_sun" android:textSize="@dimen/text_meta" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="월" android:textColor="@color/ink_faint" android:textSize="@dimen/text_meta" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="화" android:textColor="@color/ink_faint" android:textSize="@dimen/text_meta" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="수" android:textColor="@color/ink_faint" android:textSize="@dimen/text_meta" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="목" android:textColor="@color/ink_faint" android:textSize="@dimen/text_meta" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="금" android:textColor="@color/ink_faint" android:textSize="@dimen/text_meta" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="토" android:textColor="@color/weekend_sat" android:textSize="@dimen/text_meta" android:textStyle="bold" />
        </LinearLayout>

        <!-- Month grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_sm"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="7"
            tools:listitem="@layout/item_calendar_day" />

        <!-- Agenda sheet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:background="@drawable/bg_sheet_top"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingTop="@dimen/space_md">

            <LinearLayout
                android:id="@+id/agenda_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView android:id="@+id/tv_agenda_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    tools:text="6월 9일 화요일" android:textColor="@color/ink" android:textSize="@dimen/text_section" android:textStyle="bold" />
                <TextView android:id="@+id/tv_today_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm" android:background="@drawable/bg_pill" android:backgroundTint="@color/accent_dim"
                    android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:text="@string/today"
                    android:textColor="@color/accent" android:textSize="@dimen/text_caption" android:textStyle="bold" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/tv_agenda_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    tools:text="4건" android:textColor="@color/ink_soft" android:textSize="@dimen/text_meta" android:textStyle="bold" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="2dp"
                    android:src="@drawable/ic_chevron_right" app:tint="@color/ink_faint" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_agenda"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_event_agenda" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
